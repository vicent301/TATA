{
  "name": "tata",
  "version": "0.1.0",
  "private": true,
  "description": "Tata: una compañera de voz para personas mayores, y una app para que la familia arme todo desde el celular.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "web-push": "^3.6.7"
  }
}
